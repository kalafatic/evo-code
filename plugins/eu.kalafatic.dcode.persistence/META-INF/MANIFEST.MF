Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DCode Persistence
Bundle-SymbolicName: eu.kalafatic.dcode.persistence;singleton:=true
Bundle-Version: 2.6.11.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-Vendor: Kalafatic
Bundle-ActivationPolicy: lazy
Bundle-Activator: eu.kalafatic.dcode.persistence.internal.PersistenceActivator
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=21))"
Require-Bundle: eu.kalafatic.dcode.core;bundle-version="2.6.11"
Import-Package: org.osgi.framework;version="[1.10.0,2.0.0)",
 org.slf4j;version="[1.7.0,3.0.0)"
Bundle-ClassPath: .,
 lib/sqlite-jdbc.jar,
 lib/jackson-annotations-2.20.jar,
 lib/jackson-core-2.20.0.jar,
 lib/jackson-databind-2.20.0.jar
Export-Package: eu.kalafatic.dcode.persistence.config,
 eu.kalafatic.dcode.persistence.db,
 eu.kalafatic.dcode.persistence.events,
 eu.kalafatic.dcode.persistence.recovery,
 eu.kalafatic.dcode.persistence.service
Automatic-Module-Name: eu.kalafatic.dcode.persistence
