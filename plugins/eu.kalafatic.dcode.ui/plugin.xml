<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.core.runtime.applications" id="application">
      <application>
         <run class="eu.kalafatic.dcode.ui.DCodeRcpApplication"/>
      </application>
   </extension>

   <extension id="rcp" point="org.eclipse.core.runtime.products">
      <product application="eu.kalafatic.dcode.ui.application" name="EVO-Code">
         <property name="appName" value="EVO-Code"/>
      </product>
   </extension>

   <extension point="org.eclipse.ui.perspectives">
      <perspective class="eu.kalafatic.dcode.ui.DCodePerspectiveFactory"
                   fixed="true"
                   id="eu.kalafatic.dcode.ui.perspective"
                   name="EVO-Code"/>
   </extension>

   <extension point="org.eclipse.ui.views">
      <category id="eu.kalafatic.dcode.ui" name="EVO-Code"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.WorkspaceExplorerView"
            id="eu.kalafatic.dcode.ui.views.workspace"
            name="Workspace Explorer"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.SessionsView"
            id="eu.kalafatic.dcode.ui.views.sessions"
            name="Sessions"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ChatView"
            id="eu.kalafatic.dcode.ui.views.chat"
            name="AI Chat"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ActivityView"
            id="eu.kalafatic.dcode.ui.views.activity"
            name="Agent Activity"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ConsoleView"
            id="eu.kalafatic.dcode.ui.views.console"
            name="Console"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.JavaToolsView"
            id="eu.kalafatic.dcode.ui.views.javatools"
            name="Java Tools"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ChangesView"
            id="eu.kalafatic.dcode.ui.views.changes"
            name="Changes"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ProvidersView"
            id="eu.kalafatic.dcode.ui.views.providers"
            name="Providers"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ConnectionView"
            id="eu.kalafatic.dcode.ui.views.connection"
            name="Connection"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.RuntimesView"
            id="eu.kalafatic.dcode.ui.views.runtimes"
            name="Runtime Explorer"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ModelsView"
            id="eu.kalafatic.dcode.ui.views.models"
            name="Model Explorer"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.ModelManagerView"
            id="eu.kalafatic.dcode.ui.views.modelmanager"
            name="Model Manager"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.DirectChatView"
            id="eu.kalafatic.dcode.ui.views.directchat"
            name="Direct Inference Chat"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.RuntimeSelectorView"
            id="eu.kalafatic.dcode.ui.views.runtimeselector"
            name="AI Selection"
            allowMultiple="false"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.InferenceWorkspaceView"
            id="eu.kalafatic.dcode.ui.views.inference"
            name="Inference Workspace"
            restorable="true"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.AiWorkspaceView"
            id="eu.kalafatic.dcode.ui.views.aiworkspace"
            name="AI Workspace"
            allowMultiple="false"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.RuntimeExplorerView"
            id="eu.kalafatic.dcode.ui.views.runtimeexplorer"
            name="Runtime &amp; Models"
            allowMultiple="false"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.SessionNavigatorView"
            id="eu.kalafatic.dcode.ui.views.sessionnavigator"
            name="Sessions"
            allowMultiple="false"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.AgentExplorerView"
            id="eu.kalafatic.dcode.ui.views.agentexplorer"
            name="Agent Explorer"
            allowMultiple="false"/>
      <view category="eu.kalafatic.dcode.ui"
            class="eu.kalafatic.dcode.ui.views.PortMonitorView"
            id="eu.kalafatic.dcode.ui.views.portmonitor"
            name="Port &amp; Network Monitor"
            allowMultiple="false"/>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <editor class="eu.kalafatic.dcode.ui.editors.DCodeFileEditor"
              default="false"
              id="eu.kalafatic.dcode.ui.editors.file"
              name="EVO-Code Source Editor"/>
      <editor class="eu.kalafatic.dcode.ui.editors.DCodeDiffEditor"
              default="false"
              id="eu.kalafatic.dcode.ui.editors.diff"
              name="EVO-Code Diff Editor"/>
      <editor class="eu.kalafatic.dcode.ui.editors.DCodeMultiPageEditor"
              default="false"
              id="eu.kalafatic.dcode.ui.editors.multi"
              name="EVO-Code Inference"/>
   </extension>
</plugin>
