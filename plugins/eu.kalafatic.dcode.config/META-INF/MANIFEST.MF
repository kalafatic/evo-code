Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DCode Config
Bundle-SymbolicName: eu.kalafatic.dcode.config;singleton:=true
Bundle-Version: 2.6.11.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-Vendor: Kalafatic
Bundle-ActivationPolicy: lazy
Bundle-Activator: eu.kalafatic.dcode.config.internal.ConfigActivator
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=21))"
Require-Bundle: eu.kalafatic.dcode.core;bundle-version="2.6.11"
Import-Package: org.osgi.framework;version="[1.10.0,2.0.0)"
Bundle-ClassPath: .,
 lib/jackson-annotations-2.20.jar,
 lib/jackson-core-2.20.0.jar,
 lib/jackson-databind-2.20.0.jar
Export-Package: eu.kalafatic.dcode.config.credentials,
 eu.kalafatic.dcode.config.git,
 eu.kalafatic.dcode.config.model,
 eu.kalafatic.dcode.config.provider,
 eu.kalafatic.dcode.config.routing,
 eu.kalafatic.dcode.config.runtime,
 eu.kalafatic.dcode.config.agent,
 eu.kalafatic.dcode.config.profile
Automatic-Module-Name: eu.kalafatic.dcode.config
