<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<product name="EVO-Code" uid="eu.kalafatic.dcode.ui.rcp"
         id="eu.kalafatic.dcode.ui.rcp"
         application="eu.kalafatic.dcode.ui.application"
         version="2.6.11.qualifier" useFeatures="true"
         includeLaunchers="true">

   <aboutInfo>
      <text>
         EVO-Code — Darwin Code. Native AI coding harness IDE.
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <programArgs>-perspective eu.kalafatic.dcode.ui.perspective</programArgs>
      <vmArgs>-Xms256m -Xmx2g</vmArgs>
   </launcherArgs>

   <launcher name="dcode">
      <win useIco="false">
         <bmp/>
      </win>
   </launcher>

   <splash
         location="eu.kalafatic.dcode.ui"
         startupProgressRect="212,348,350,2"
         startupMessageRect="212,335,350,5"
         startupForegroundColor="FF0000"/>

   <features>
      <feature id="eu.kalafatic.dcode.feature"/>
      <feature id="org.eclipse.rcp"/>
      <feature id="org.eclipse.e4.rcp"/>
   </features>

   <plugins>
      <plugin id="org.eclipse.ui.themes"/>
   </plugins>

   <configurations>
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2"/>
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4"/>
      <plugin id="org.eclipse.core.resources" autoStart="true" startLevel="4"/>
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2"/>
      <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2"/>
      <plugin id="eu.kalafatic.dcode.core" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.config" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.client" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.repositories" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.harness" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.persistence" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.java.tooling" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.server" autoStart="true" startLevel="4"/>
      <plugin id="eu.kalafatic.dcode.ui" autoStart="true" startLevel="4"/>
      <plugin id="org.eclipse.equinox.security" autoStart="true" startLevel="4"/>
   </configurations>

   <properties>
      <property name="cssTheme" value="org.eclipse.e4.ui.css.theme.e4_default"/>
   </properties>
</product>
